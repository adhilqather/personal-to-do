<resources>
    <!-- Base Theme -->
    <style name="Theme.BlackGoldTodo" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary Colors -->
        <item name="colorPrimary">@color/gold_primary</item>
        <item name="colorPrimaryVariant">@color/gold_dark</item>
        <item name="colorOnPrimary">@color/text_on_gold</item>

        <!-- Secondary Colors -->
        <item name="colorSecondary">@color/gold_subtle</item>
        <item name="colorSecondaryVariant">@color/gold_dark</item>
        <item name="colorOnSecondary">@color/text_on_gold</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/black_amoled</item>
        <item name="colorSurface">@color/black_surface_1</item>
        <item name="colorSurfaceVariant">@color/black_surface_2</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- Error -->
        <item name="colorError">@color/priority_high</item>
        <item name="colorOnError">@color/text_primary</item>

        <!-- Outline -->
        <item name="colorOutline">@color/border_gold</item>
        <item name="colorOutlineVariant">@color/border_subtle</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/black_amoled</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/black_amoled</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Window -->
        <item name="android:windowBackground">@color/black_amoled</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>

        <!-- Typography -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_muted</item>

        <!-- Ripple -->
        <item name="colorControlHighlight">@color/gold_20</item>

        <!-- Material Components -->
        <item name="materialCardViewStyle">@style/Widget.BlackGoldTodo.CardView</item>
        <item name="buttonStyle">@style/Widget.BlackGoldTodo.Button</item>
        <item name="textInputStyle">@style/Widget.BlackGoldTodo.TextInputLayout</item>
        <item name="chipStyle">@style/Widget.BlackGoldTodo.Chip</item>
        <item name="bottomNavigationStyle">@style/Widget.BlackGoldTodo.BottomNavigationView</item>
        <item name="floatingActionButtonStyle">@style/Widget.BlackGoldTodo.FAB</item>
    </style>

    <!-- Splash Theme -->
    <style name="Theme.BlackGoldTodo.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/black_amoled</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">800</item>
        <item name="postSplashScreenTheme">@style/Theme.BlackGoldTodo</item>
    </style>

    <!-- Card View -->
    <style name="Widget.BlackGoldTodo.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/black_surface_1</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/border_subtle</item>
        <item name="strokeWidth">0.5dp</item>
    </style>

    <!-- Button Styles -->
    <style name="Widget.BlackGoldTodo.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/gold_primary</item>
        <item name="android:textColor">@color/text_on_gold</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:paddingHorizontal">24dp</item>
        <item name="rippleColor">@color/gold_30</item>
    </style>

    <style name="Widget.BlackGoldTodo.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/gold_primary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/gold_primary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="rippleColor">@color/gold_20</item>
    </style>

    <style name="Widget.BlackGoldTodo.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/gold_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="rippleColor">@color/gold_15</item>
    </style>

    <!-- Text Input Layout -->
    <style name="Widget.BlackGoldTodo.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/black_surface_2</item>
        <item name="boxStrokeColor">@color/border_gold</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/text_muted</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="placeholderTextColor">@color/text_muted</item>
    </style>

    <!-- Chip - only use standard attributes -->
    <style name="Widget.BlackGoldTodo.Chip" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="chipBackgroundColor">@color/black_surface_2</item>
        <item name="chipStrokeColor">@color/border_subtle</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Bottom Navigation -->
    <style name="Widget.BlackGoldTodo.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="backgroundTint">@color/black_surface_1</item>
        <item name="itemIconTint">@color/bottom_nav_selector</item>
        <item name="itemTextColor">@color/bottom_nav_selector</item>
        <item name="itemRippleColor">@color/gold_15</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <!-- FAB -->
    <style name="Widget.BlackGoldTodo.FAB" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/black_surface_1</item>
        <item name="tint">@color/gold_primary</item>
        <item name="rippleColor">@color/gold_20</item>
        <item name="strokeColor">@color/gold_primary</item>
        <item name="strokeWidth">2dp</item>
        <item name="elevation">4dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.BlackGoldTodo.FAB</item>
    </style>

    <style name="ShapeAppearance.BlackGoldTodo.FAB" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Search View -->
    <style name="Widget.BlackGoldTodo.SearchView" parent="Widget.AppCompat.SearchView">
        <item name="queryBackground">@color/black_surface_2</item>
        <item name="iconTint">@color/text_muted</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
    </style>

    <!-- Switch -->
    <style name="Widget.BlackGoldTodo.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="trackColor">@color/switch_track_selector</item>
        <item name="thumbColor">@color/switch_thumb_selector</item>
    </style>

    <!-- Toolbar Title -->
    <style name="Widget.BlackGoldTodo.Toolbar.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/gold_primary</item>
    </style>

</resources>
