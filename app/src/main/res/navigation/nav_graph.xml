<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.blackgold.todo.ui.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_addEditTodoFragment"
            app:destination="@id/addEditTodoFragment" />
    </fragment>

    <fragment
        android:id="@+id/todosFragment"
        android:name="com.blackgold.todo.ui.TodosFragment"
        android:label="Tasks"
        tools:layout="@layout/fragment_todos">
        <action
            android:id="@+id/action_todosFragment_to_addEditTodoFragment"
            app:destination="@id/addEditTodoFragment" />
    </fragment>

    <fragment
        android:id="@+id/remindersFragment"
        android:name="com.blackgold.todo.ui.RemindersFragment"
        android:label="Reminders"
        tools:layout="@layout/fragment_reminders">
        <action
            android:id="@+id/action_remindersFragment_to_addEditTodoFragment"
            app:destination="@id/addEditTodoFragment" />
    </fragment>

    <fragment
        android:id="@+id/completedFragment"
        android:name="com.blackgold.todo.ui.CompletedFragment"
        android:label="Completed"
        tools:layout="@layout/fragment_completed">
        <action
            android:id="@+id/action_completedFragment_to_addEditTodoFragment"
            app:destination="@id/addEditTodoFragment" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.blackgold.todo.ui.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/addEditTodoFragment"
        android:name="com.blackgold.todo.ui.AddEditTodoFragment"
        android:label="Add/Edit Task"
        tools:layout="@layout/fragment_add_edit_todo">
        <argument
            android:name="todoId"
            app:argType="long"
            android:defaultValue="0L" />
    </fragment>

</navigation>
